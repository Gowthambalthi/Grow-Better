//@version=6
indicator("4-Pattern Breakout Engine (Cup&Handle, IHS, Rectangle, Ascending Triangle + RSI) [OpenAlgo]", overlay=true)

// ==============================================================================
// 1. INPUTS & CONFIGURATION (Calibrated at 20 Concurrent Slots / 4-5 Calls/Week)
// ==============================================================================
rsiPeriod         = input.int(14, "RSI Period", minval=5)
rsiMin            = input.float(48.0, "RSI Min (Healthy Momentum)", step=1.0)
rsiMax            = input.float(75.0, "RSI Max (Anti-Exhaustion Cap)", step=1.0)

minRiskPct        = input.float(2.5, "Min Stop Distance %", step=0.5) / 100.0
maxRiskPct        = input.float(7.5, "Max Stop Distance %", step=0.5) / 100.0
target1Pct        = input.float(8.0, "Target 1 % (Take 50% Profit)", step=0.5) / 100.0

// ==============================================================================
// 2. TECHNICAL CALCULATIONS
// ==============================================================================
atr14 = ta.atr(14)
rsi14 = ta.rsi(close, rsiPeriod)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)

// RSI Momentum Filter
bool rsiValid = (rsi14 >= rsiMin and rsi14 <= rsiMax)

// ==============================================================================
// 3. PATTERN DETECTORS
// ==============================================================================

// --- Pattern 1: Rectangle Consolidation (30 bars, range <= 14%) ---
rectH = ta.highest(high[1], 30)
rectL = ta.lowest(low[1], 30)
rectRangePct = ((rectH - rectL) / rectL) * 100.0
bool rectBreakout = (rectRangePct <= 14.0) and (close > rectH) and (close[1] <= rectH * 1.005)

// --- Pattern 2: Cup and Handle (55-bar rounded base with shallow handle) ---
cupH = ta.highest(high[10], 45) // Left/Right rim peak
cupL = ta.lowest(low[10], 45)   // Bowl bottom
handleL = ta.lowest(low[1], 10)  // Handle pullback
cupDepth = (cupH - cupL) / cupH
handleDepth = (cupH - handleL) / cupH
bool cupBreakout = (cupDepth >= 0.10 and cupDepth <= 0.38) and (handleDepth <= cupDepth * 0.45) and (close > cupH * 0.998) and (close[1] <= cupH * 1.005)

// --- Pattern 3: Inverse Head & Shoulders ---
lsLow = ta.lowest(low[45], 25)
headLow = ta.lowest(low[20], 25)
rsLow = ta.lowest(low[1], 20)
neckH = math.min(ta.highest(high[45], 25), ta.highest(high[1], 20))
bool ihsValid = (headLow < lsLow) and (headLow < rsLow) and (math.abs(rsLow / lsLow - 1.0) <= 0.06)
bool ihsBreakout = ihsValid and (close > neckH) and (close[1] <= neckH * 1.005)

// --- Pattern 4: Ascending Triangle (Flat resistance + rising lows) ---
triH = ta.highest(high[1], 40)
triL1 = ta.lowest(low[20], 20)
triL2 = ta.lowest(low[1], 20)
bool triBreakout = (triL2 > triL1) and (close > triH) and (close[1] <= triH * 1.005)

// ==============================================================================
// 4. SIGNAL SELECTION & STRUCTURAL RISK
// ==============================================================================
bool isSignal = false
string detectedPattern = ""
float stopLevel = 0.0

if cupBreakout and rsiValid
    isSignal := true
    detectedPattern := "Cup & Handle"
    stopLevel := handleL
else if ihsBreakout and rsiValid
    isSignal := true
    detectedPattern := "Inverse H&S"
    stopLevel := rsLow
else if rectBreakout and rsiValid
    isSignal := true
    detectedPattern := "Rectangle"
    stopLevel := rectL
else if triBreakout and rsiValid
    isSignal := true
    detectedPattern := "Ascending Triangle"
    stopLevel := triL2

// Structural Stop Distance bounds
float rawRisk = (close - stopLevel) / close
float activeStop = stopLevel
if rawRisk < minRiskPct
    activeStop := close * (1.0 - minRiskPct)
else if rawRisk > maxRiskPct
    activeStop := close * (1.0 - maxRiskPct)

float target1Price = close * (1.0 + target1Pct)

// ==============================================================================
// 5. VISUALIZATION & LABELS
// ==============================================================================
plotshape(isSignal, title="Trio Breakout Signal", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="TRIO BREAK", textcolor=color.white, size=size.small)

if isSignal
    label.new(bar_index, high, text=detectedPattern + "\nEntry: " + str.tostring(close, "#.##") + "\nSL: " + str.tostring(activeStop, "#.##") + "\nT1: " + str.tostring(target1Price, "#.##"), color=color.new(color.teal, 10), textcolor=color.white, style=label.style_label_down)

plot(isSignal ? activeStop : na, "Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(isSignal ? target1Price : na, "Target 1 (+8%)", color=color.green, style=plot.style_linebr, linewidth=2)
plot(ema20, "20 EMA (Runner Trail)", color=color.orange, linewidth=1)
